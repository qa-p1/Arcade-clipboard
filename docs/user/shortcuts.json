{
  "schema": 1,
  "app": "arcade.clipboard",
  "version": "0.1.0",
  "groups": [
    {
      "title": "Global",
      "context": "global",
      "shortcuts": [
        {
          "id": "picker",
          "title": "Open the clipboard picker",
          "keys": {
            "default": "Ctrl+Shift+Space",
            "windows": "Ctrl+Alt+V",
            "macos": "Shift+Super+V"
          },
          "rebindable": true
        }
      ]
    },
    {
      "title": "Clip picker",
      "context": "overlay",
      "shortcuts": [
        { "id": "move-up", "title": "Select the previous clip", "keys": { "default": "Up" } },
        { "id": "move-down", "title": "Select the next clip", "keys": { "default": "Down" } },
        { "id": "first-clip", "title": "Select the first clip", "keys": { "default": "Home" } },
        { "id": "last-clip", "title": "Select the last clip", "keys": { "default": "End" } },
        { "id": "choose-clip", "title": "Paste or choose the selected clip", "keys": { "default": "Enter" } },
        { "id": "close-picker", "title": "Close the picker", "keys": { "default": "Escape" } },
        { "id": "quick-look", "title": "Open the selected item in Arcade Look", "keys": { "default": "Ctrl+Alt+Q" } },
        { "id": "analyze-with-lens", "title": "Analyze the selected image with Lens", "keys": { "default": "Ctrl+Alt+A" } },
        { "id": "pin-with-lens", "title": "Pin the selected image with Lens", "keys": { "default": "Ctrl+Alt+P" } },
        { "id": "extract-text", "title": "Extract text from the selected image", "keys": { "default": "Ctrl+Alt+E" } },
        { "id": "convert-to-png", "title": "Convert the selected image to PNG", "keys": { "default": "Ctrl+Alt+N" } },
        { "id": "compress-image", "title": "Compress an oversized image", "keys": { "default": "Ctrl+Alt+C" } },
        { "id": "format-json", "title": "Format selected JSON text", "keys": { "default": "Ctrl+Alt+J" } },
        { "id": "clean-text", "title": "Clean the selected text", "keys": { "default": "Ctrl+Alt+T" } },
        { "id": "add-to-shelf", "title": "Add the selected clip to Arcade Shelf", "keys": { "default": "Ctrl+Alt+H" } }
      ]
    },
    {
      "title": "Shortcut settings",
      "context": "settings-shortcut",
      "shortcuts": [
        { "id": "cancel-shortcut-recording", "title": "Cancel shortcut recording", "keys": { "default": "Escape" } }
      ]
    }
  ]
}
